DATABASE_URL="postgresql://user:password@localhost:5432/leonardo?schema=public"

# NextAuth
AUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Primeiro usuário (usado pelo script de seed: npm run db:seed)
SEED_USER_EMAIL="voce@exemplo.com"
SEED_USER_PASSWORD="escolha-uma-senha-forte"
SEED_USER_NAME="Seu nome"

# Resend (envio de e-mail de lembretes) - https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Protocolos Societários <onboarding@resend.dev>"
EMAIL_TO="voce@exemplo.com"

# Segredo para autorizar chamadas ao endpoint de cron (gere um valor aleatório)
CRON_SECRET="gere-com: openssl rand -base64 32"
