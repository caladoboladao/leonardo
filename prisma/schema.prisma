// Schema da Plataforma de Acompanhamento de Protocolos Societários

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo pronto para multiusuário futuro: tudo pendura em um User,
// mas hoje só existe um usuário (uso individual).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  protocolos    Protocolo[]
  orgaos        Orgao[]
  tiposAto      TipoAto[]
  status        Status[]
  empresas      Empresa[]
  tarefas       Tarefa[]
  modelosTarefa ModeloTarefa[]
  settings      Settings?
}

// Configurações editáveis pelo usuário (nada fixo no código)
model Settings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // dias de antecedência para gerar lembrete automático de vencimento de prazo
  diasAlertaPrazo Int @default(5)
  // dias sem mudança de status para gerar lembrete automático de inatividade
  diasParado      Int @default(7)

  // status para o qual o protocolo é movido automaticamente ao abrir uma
  // exigência (opcional — se não configurado, o status não muda sozinho)
  statusEmExigenciaId String?
  statusEmExigencia   Status? @relation(fields: [statusEmExigenciaId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

// Lista de órgãos editável pelo usuário (JUCEAL, JUCEC, Prefeituras, SEFAZ, etc.)
model Orgao {
  id     String @id @default(cuid())
  nome   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  protocolos Protocolo[]

  createdAt DateTime @default(now())

  @@unique([userId, nome])
}

// Lista de tipos de ato editável pelo usuário
model TipoAto {
  id     String @id @default(cuid())
  nome   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  protocolos    Protocolo[]
  modelosTarefa ModeloTarefa[]

  createdAt DateTime @default(now())

  @@unique([userId, nome])
}

// Lista de status editável pelo usuário, com cor e ordem de exibição
model Status {
  id     String @id @default(cuid())
  nome   String
  cor    String @default("#6b7280")
  ordem  Int    @default(0)
  // status que representa "concluído" para fins de arquivo/histórico
  isConcluido Boolean @default(false)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  protocolos            Protocolo[]
  historicoStatusNovo   StatusHistorico[] @relation("statusNovo")
  historicoStatusAntigo StatusHistorico[] @relation("statusAnterior")
  settingsEmExigencia   Settings[]

  createdAt DateTime @default(now())

  @@unique([userId, nome])
}

// Empresa é o "dono" real dos protocolos — uma mesma empresa normalmente
// tem vários protocolos ao longo do tempo. Agrupada por CNPJ quando
// disponível, senão pelo nome.
model Empresa {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  razaoSocial String
  cnpj        String?
  observacoes String?

  protocolos Protocolo[]
  tarefas    Tarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cnpj])
  @@index([userId, razaoSocial])
}

model Protocolo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  empresa            String
  empresaId          String
  empresaRef         Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empresasVinculadas EmpresaVinculada[]
  protocolosVinculados ProtocoloVinculado[]

  numeroProtocolo String?
  cnpj            String?

  orgaoId String?
  orgao   Orgao?  @relation(fields: [orgaoId], references: [id])

  tipoAtoId String?
  tipoAto   TipoAto? @relation(fields: [tipoAtoId], references: [id])

  statusId String
  status   Status  @relation(fields: [statusId], references: [id])

  dataInicio      DateTime
  prazoDias       Int?
  dataVencimento  DateTime?
  // preenchida automaticamente quando o status muda pra um marcado como
  // "conclui protocolo"; limpa se o protocolo for reaberto
  dataConclusao   DateTime?

  clienteResponsavel String?
  observacoes        String?

  ultimaMudancaStatusEm DateTime @default(now())

  // marca que já foi gerado lembrete automático para o ciclo atual de prazo/inatividade,
  // evitando duplicar lembretes a cada execução do job de automação
  alertaPrazoGeradoEm  DateTime?
  alertaParadoGeradoEm DateTime?

  historicoStatus StatusHistorico[]
  lembretes       Lembrete[]
  tarefas         Tarefa[]
  exigencias      Exigencia[]
  lancamentos     Lancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, statusId])
  @@index([userId, dataVencimento])
  @@index([userId, empresaId])
}

model EmpresaVinculada {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  nome        String
}

// Números de protocolo relacionados ao protocolo principal (ex.: protocolos
// conexos abertos no mesmo assunto). Não aparecem na listagem principal,
// apenas no painel de detalhes/criação.
model ProtocoloVinculado {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  numero      String
}

model StatusHistorico {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  statusAnteriorId String?
  statusAnterior   Status? @relation("statusAnterior", fields: [statusAnteriorId], references: [id])

  statusNovoId String
  statusNovo   Status @relation("statusNovo", fields: [statusNovoId], references: [id])

  changedAt DateTime @default(now())
}

enum OrigemLembrete {
  MANUAL
  PRAZO_EXIGENCIA
  PRAZO_ORGAO
  PARADO_SEM_MOVIMENTACAO
}

enum StatusLembrete {
  PENDENTE
  RESOLVIDO
}

model Lembrete {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  dataHora DateTime @default(now())
  nota     String

  origem OrigemLembrete @default(MANUAL)
  status StatusLembrete @default(PENDENTE)

  emailEnviadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([protocoloId, status])
}

enum StatusExigencia {
  ABERTA
  CUMPRIDA
}

// Exigência recebida do órgão sobre um protocolo em andamento — tem prazo
// próprio para cumprimento, independente do prazo do protocolo.
model Exigencia {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  dataRecebimento  DateTime        @default(now())
  descricao        String
  // dias a partir do recebimento para cumprir a exigência (editável)
  prazoCumprimento Int             @default(30)
  dataCumprimento  DateTime?
  numeroReprotocolo String?
  status           StatusExigencia @default(ABERTA)

  // marca que já foi gerado lembrete automático de prazo próximo, evita duplicar
  alertaPrazoGeradoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([protocoloId, status])
}

enum TipoLancamento {
  TAXA
  HONORARIO
}

enum SituacaoLancamento {
  A_PAGAR
  PAGO
  A_FATURAR
  FATURADO
  RECEBIDO
}

// Taxa (recolhida a órgãos) ou honorário (cobrado do cliente) ligado a um
// protocolo. Taxas seguem a_pagar/pago; honorários seguem
// a_faturar/faturado/recebido.
model Lancamento {
  id          String    @id @default(cuid())
  protocoloId String
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  tipo          TipoLancamento
  descricao     String
  valor         Float
  vencimento    DateTime?
  dataPagamento DateTime?
  situacao      SituacaoLancamento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([protocoloId])
}

enum OrigemTarefa {
  MANUAL
  MODELO
}

// Tarefa avulsa ou vinculada a um protocolo/empresa. Pode ser criada
// manualmente ou gerada automaticamente a partir de um ModeloTarefa.
model Tarefa {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titulo    String
  descricao String?
  prazo     DateTime?
  concluida Boolean   @default(false)
  dataConclusao DateTime?

  protocoloId String?
  protocolo   Protocolo? @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  ordem  Int          @default(0)
  origem OrigemTarefa @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, concluida, prazo])
  @@index([protocoloId])
  @@index([empresaId])
}

enum GatilhoModeloTarefa {
  CRIACAO
  CONCLUSAO
}

// Modelo de checklist de tarefas por tipo de ato — ao criar um protocolo
// desse tipo (gatilho CRIACAO) ou ao concluí-lo (gatilho CONCLUSAO), as
// tarefas configuradas aqui são geradas automaticamente.
model ModeloTarefa {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipoAtoId String
  tipoAto   TipoAto @relation(fields: [tipoAtoId], references: [id], onDelete: Cascade)

  titulo            String
  descricao         String?
  // dias relativos à data de gatilho (criação ou conclusão do protocolo)
  // para calcular o prazo da tarefa gerada; null = sem prazo
  prazoDiasRelativo Int?
  gatilho           GatilhoModeloTarefa @default(CRIACAO)
  ordem             Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tipoAtoId, gatilho, ordem])
}
